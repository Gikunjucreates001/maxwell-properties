# Server Configuration
PORT=5000

# Supabase Postgres connection string (server-only; never expose it to the browser)
SUPABASE_DB_URL=
SUPABASE_DB_SSL=true
SUPABASE_DB_SSL_REJECT_UNAUTHORIZED=true
# Base64-encoded Supabase pooler root CA for verified TLS from Vercel
# SUPABASE_DB_SSL_CA_BASE64=
DB_POOL_MAX=5
# Optional path to the legacy SQLite file used by the transfer tool
# LEGACY_SQLITE_PATH=./data/maxwell.db

# Local fallback JWT secrets (change these in production)
JWT_SECRET=maxwell-props-secret-key-2024
JWT_REFRESH_SECRET=maxwell-props-refresh-secret-key-2024

# Required in production: keep admin and manager signing keys separate
ADMIN_JWT_SECRET=
MANAGER_JWT_SECRET=
ADMIN_JWT_REFRESH_SECRET=
MANAGER_JWT_REFRESH_SECRET=

# Required only when starting a new production database without an admin account
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Single primary owner account. The normalization script uses these values
# after the SQLite transfer and keeps every other admin account inactive.
PRIMARY_ADMIN_EMAIL=pnganga0133@gmail.com
PRIMARY_ADMIN_UID=de5516ae-cc87-4061-912f-0971cb40b102
PRIMARY_ADMIN_NAME=
# Only required if the requested primary account is not already in users
PRIMARY_ADMIN_PASSWORD=
PUBLIC_APP_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=30
# Minimum time between administrator recovery emails (Supabase also enforces its own quota)
SUPABASE_AUTH_EMAIL_COOLDOWN_MINUTES=60

# Set to true when the API is behind a trusted reverse proxy
TRUST_PROXY=false

# Frontend URL(s) for CORS; separate multiple origins with commas
CLIENT_URL=http://localhost:5173
# CLIENT_URLS=http://localhost:5173,https://app.example.com

# Google Identity Services web client ID (optional until Google sign-in is configured)
GOOGLE_CLIENT_ID=

# Supabase Auth settings used for password-recovery and manager Auth accounts.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Optional server-only Supabase service-role key for linking an existing Auth account.
# Never expose this as a VITE_* variable or commit it.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional outbound SMS (Twilio REST API)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Automatic month-end reminder scheduler
ENABLE_AUTOMATIC_REMINDERS=false
REMINDER_DAY_OF_MONTH=25
REMINDER_MESSAGE=Hello, this is a reminder that your monthly payment is due soon. Please contact the property team if you need help.

# Optional frontend API URL for separate deployments (local development uses the Vite proxy)
# VITE_API_URL=

